#!/bin/sh
# Super press: mark down only. The menu opens on release
# (super-menu-release) unless a chord set the chord flag.
set -e

STATE_DIR="${STATE_DIR:-$HOME/.cache/super-menu-chord}"

mkdir -p "$STATE_DIR"

# Do not remove the chord flag. A fullscreen client holds the
# keyboard, so this press is delivered only after the bhotkeys
# panel takes the grab, and that late press was deleting the flag
# bhotkeys had just written for Super+/. Release consumes the flag.
# A flag left behind from a crashed session suppresses one tap.

# Cancel a legacy press-timer from an older super-menu-arm
if [ -f "$STATE_DIR/pending.pid" ]; then
	old=$( cat "$STATE_DIR/pending.pid" 2> /dev/null ) || old=
	if [ "$old" ]; then
		kill "$old" 2> /dev/null || : kill ignored
	fi
	rm -f "$STATE_DIR/pending.pid"
fi

: > "$STATE_DIR/down"
