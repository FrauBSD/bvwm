DestroyFunc TileRestore
AddToFunc   TileRestore
+ I PipeRead `fvwm-tile remove $[w.id]`
+ I ThisWindow (Maximized) Maximize False
+ I State 3 False
+ I DestroyWindowStyle
+ I Raise
+ I Focus

# Super+Tab: immediate focus cycle on this monitor + pager page (tile or
# float).  Not the Alt+Tab WindowList.  Super+Shift+Tab walks backward.
# Skip pager/taskbar/Florence/Conky via CirculateSkip + WindowListSkip.
DestroyFunc SuperTabSelect
AddToFunc   SuperTabSelect
+ I WindowShade False
+ I Iconify off
+ I Raise
+ I Focus NoWarp

DestroyFunc SuperTab
AddToFunc   SuperTab
+ I Next (CurrentPage, CurrentScreen, AcceptsFocus, !Iconic, \
	!CirculateSkip, !WindowListSkip) SuperTabSelect

DestroyFunc SuperTabBack
AddToFunc   SuperTabBack
+ I Prev (CurrentPage, CurrentScreen, AcceptsFocus, !Iconic, \
	!CirculateSkip, !WindowListSkip) SuperTabSelect

# Super+`: same cycle, but only WM_CLASS of the focused window.
# Bind like SuperTab (no Current on the Key line; Current there skips
# CirculateSkip focus and the chord never runs).  Current wraps PipeRead
# so $[w.class] expands from the focused window.
DestroyFunc SuperGrave
AddToFunc   SuperGrave
+ I Current PipeRead `bvwm-same-class Next $[w.class]`

DestroyFunc SuperGraveBack
AddToFunc   SuperGraveBack
+ I Current PipeRead `bvwm-same-class Prev $[w.class]`

# Super+Left/Right: halves. Super+Up: fill working area (covers pager).
# Super+Down: restore floating (also drops the window from Super+T layout).
# Super+Shift+Up/Down: top/bottom halves. Super+Shift+Left/Right: top quarters.
# Super+Ctrl+Left/Right: bottom quarters.
# Super+Ctrl+Up: insert into layout, or rotate/swap the focused window.
# Super+Ctrl+Down: previous cell (floating), or eject (auto-tile).
# Super+Tab / Super+Shift+Tab: cycle focus (no WindowList).
# Super+` / Super+Shift+`: same, limited to the focused window's class.
Key Left	A 4	Current TileApply 50 100 0 0
Key Right	A 4	Current TileApply 50 100 50 0
Key Up		A 4	Current TileMaximize
Key Down	A 4	Current TileRestore
Key Up		A 4S	Current TileApply 100 50 0 0
Key Down	A 4S	Current TileApply 100 50 0 50
Key Left	A 4S	Current TileApply 50 50 0 0
Key Right	A 4S	Current TileApply 50 50 50 0
Key Left	A 4C	Current TileApply 50 50 0 50
Key Right	A 4C	Current TileApply 50 50 50 50
Key Up		A 4C	Current TileInsert
Key Down	A 4C	Current TileRotateBack
Key t		A 4	TileAutoToggle
Key T		A 4	TileAutoToggle
Key Tab		A 4	SuperTab
Key Tab		A 4S	SuperTabBack
Key ISO_Left_Tab	A 4	SuperTabBack
Key ISO_Left_Tab	A 4S	SuperTabBack
Key grave		A 4	SuperGrave
Key grave		A 4S	SuperGraveBack
Key quoteleft		A 4	SuperGrave
Key quoteleft		A 4S	SuperGraveBack
Key dead_grave		A 4	SuperGrave
Key dead_grave		A 4S	SuperGraveBack
Key asciitilde		A 4	SuperGraveBack
Key asciitilde		A 4S	SuperGraveBack
Key dead_tilde		A 4	SuperGraveBack
Key dead_tilde		A 4S	SuperGraveBack

# New windows join the auto-tile layout. Closed windows leave it.
# A second FvwmEvent alias, so the stock desk event module stays.
DestroyModuleConfig FvwmEventTile: *
*FvwmEventTile: add_window TileAutoMapped
*FvwmEventTile: destroy_window TileDestroyed
KillModule FvwmEventTile
Module FvwmEvent FvwmEventTile
