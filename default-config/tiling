+ I PipeRead `fvwm-tile harvest-begin $[monitor.current] $[monitor.$[monitor.current].desk] $[monitor.$[monitor.current].pagex] $[monitor.$[monitor.current].pagey] $[monitor.$[monitor.current].x] $[monitor.$[monitor.current].y] $[vp.width] $[vp.height]`
+ I All (CurrentPage, CurrentScreen, Maximizable, !Transient, \
	!CirculateSkip, !Iconic, !WindowListSkip, !State 1, !State 2, \
	!"florence", !"Florence", !"florence-sticky", !"Florence-sticky", \
